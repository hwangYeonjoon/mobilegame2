GAME_DOMAIN=game.example.com
ACME_EMAIL=operator@example.com
RELEASE_TAG=0.19.0
CADDY_IMAGE=caddy:2-alpine
# Replace this with a random 16-80 character code. Never commit .env.
BETA_INVITE_CODE=replace-with-a-random-32-character-code
# Enable only after DNS, HTTPS, backup and restore checks succeed.
REGISTRATION_ENABLED=false
MAINTENANCE_MODE=false

# Disabled by default. license_test accepts only test receipts; production needs its explicit release gate.
COMMERCE_MODE=disabled
PLAY_PACKAGE_NAME=io.github.hwangyeonjoon.scrapguard
# Google Cloud: Scrap Guard / intended project ID scrapguard-prod (not created yet).
GOOGLE_WEB_CLIENT_ID=
# In local .env or runtime environment only: absolute path to a read-only service-account credential file.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json

# Publish to the intended Play track before increasing the minimum.
CLIENT_LATEST_BUILD=19
CLIENT_MIN_BUILD=19
CLIENT_LATEST_VERSION=0.19.0
PLAY_UPDATE_AVAILABLE=false
CLIENT_UPDATE_NOTES=새로운 수호대 콘텐츠와 안정성 개선을 확인하세요.

# Verification stays available when new sales are paused. Enable only after Play setup.
COMMERCE_SALES_ENABLED=false
COMMERCE_RELEASE_READY=false
# Keep ad skip off sale until ads and restoration have been verified.
COMMERCE_DISABLED_PRODUCTS=ad_skip_lifetime

# One AdMob account may host several apps. Create separate IDs for this game.
ADS_MODE=disabled
ADS_RELEASE_READY=false
ADMOB_REWARDED_UNIT_ID=
# Configure these exact values in the AdMob rewarded unit (SSV validates them).
ADMOB_REWARD_ITEM=reward
ADMOB_REWARD_AMOUNT=1

# Authenticated Google Pub/Sub push; enable only after console setup.
RTDN_ENABLED=false
RTDN_AUDIENCE=
RTDN_SERVICE_ACCOUNT_EMAIL=
RTDN_SUBSCRIPTION=
