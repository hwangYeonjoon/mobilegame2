GAME_DOMAIN=game.example.com
ACME_EMAIL=operator@example.com
RELEASE_TAG=0.14.0
CADDY_IMAGE=caddy:2-alpine
# Replace this with a random 16-80 character code. Never commit .env.
BETA_INVITE_CODE=replace-with-a-random-32-character-code
# Enable only after DNS, HTTPS, backup and restore checks succeed.
REGISTRATION_ENABLED=false
MAINTENANCE_MODE=false

# Disabled by default. license_test accepts Google license-test purchases only; production sales stay blocked.
COMMERCE_MODE=disabled
PLAY_PACKAGE_NAME=com.scrapguard.mobilegame2.prototype
GOOGLE_WEB_CLIENT_ID=
# In local .env or runtime environment only: absolute path to a read-only service-account credential file.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json

# Publish to the intended Play track before increasing the minimum.
CLIENT_LATEST_BUILD=14
CLIENT_MIN_BUILD=14
CLIENT_LATEST_VERSION=0.14.0
PLAY_UPDATE_AVAILABLE=false
CLIENT_UPDATE_NOTES=새로운 수호대 콘텐츠와 안정성 개선을 확인하세요.
