{
	email {$ACME_EMAIL}
	admin off
}
{$GAME_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 2MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
	@public path / /privacy /support /delete-account /site.css /delete-account.js /app-ads.txt
	handle @public {
		root * /srv
		try_files {path} {path}.html
		file_server
	}
	handle {
		reverse_proxy api:8080 {
		health_uri /health/ready
		health_interval 30s
		health_timeout 3s
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
	}
}
