{
	email {$ACME_EMAIL}
	admin off
}
{$GAME_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 2MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy api:8080 {
		health_uri /health/ready
		health_interval 30s
		health_timeout 3s
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
}
